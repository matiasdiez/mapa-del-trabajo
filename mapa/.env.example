# Variables de entorno — Mapa Industrial Argentina
# Copiar a .env y completar con valores reales. NUNCA commitear .env

# ── Neon (PostgreSQL serverless) ──────────────────────────────────────────────
# Obtener desde Neon dashboard → proyecto → "Connection string"
# Formato: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
 
# ── DuckDB (base analítica local) ─────────────────────────────────────────────
# Ruta relativa a mapa/ o absoluta. No requiere credenciales.
DUCKDB_PATH=data/analytics.db

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mapa-industrial-tiles
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── APIs externas ─────────────────────────────────────────────────────────────
GEOREF_API_BASE=https://apis.datos.gob.ar/georef/api

# ── Directorios de datos (opcional: defaults en config.py) ────────────────────
# DATA_INCOMING_DIR=data/incoming
# DATA_PROCESSED_DIR=data/processed
